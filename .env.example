# ============================================================
# [课程管理系统] Docker 环境变量配置
# 复制此文件为 .env 并修改为你的实际值
# 所有参数均被 docker-compose.yml / docker-compose.deploy.yml 引用
# ============================================================

# ======================== 端口配置 ========================
# 后端 API 对外映射端口（默认 35000）
BACKEND_PORT=35000
# 前端页面对外映射端口（默认 18080）
FRONTEND_PORT=18080

# ======================== Docker 网络 ========================
# 容器内部子网地址段（默认 172.18.16.0/24，若与宿主机网络冲突可修改）
DOCKER_SUBNET=172.18.16.0/24

# ======================== 数据库配置 ========================
# 数据库端口（容器内部，默认 5432，一般无需修改）
DB_PORT=5432
# 数据库名称（默认 cadb）
POSTGRES_DB=cadb
# 数据库用户名（默认 cadbuser）
POSTGRES_USER=cadbuser
# 数据库密码（必须修改！建议使用 24 位随机字母+数字组合）
# Windows PowerShell 生成: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 24 | ForEach-Object {[char]$_})
# Linux Shell 生成: tr -dc A-Za-z0-9 </dev/urandom | head -c 24
POSTGRES_PASSWORD=MIMA2026nicai
# 数据库最大连接数（默认 200）
POSTGRES_MAX_CONNECTIONS=200

# ======================== 应用安全 ========================
# 应用密钥（必须修改！使用 openssl rand -hex 32 生成）
SECRET_KEY=Xk9mP2vL7nQ4wR8tY3uJ6bN0aC1dF5gH9iO2sK4mP6qR8vU0wX2yZ4aB6cD8e
# 允许的跨域来源（多个用逗号分隔，需与 FRONTEND_PORT 对应）
ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# ======================== 后端性能 ========================
# 数据库连接池大小（默认 10）
DB_POOL_SIZE=10
# 连接池最大溢出（默认 20）
DB_MAX_OVERFLOW=20
# 连接池超时秒数（默认 30）
DB_POOL_TIMEOUT=30
# 连接池回收秒数（默认 1800）
DB_POOL_RECYCLE=1800
# Uvicorn 工作进程数
# ⚠️ 当前【不生效】：backend/Dockerfile 的启动命令是
#      uvicorn main:app --host 0.0.0.0 --port 8000
#    并没有传 --workers，本变量不会被读取。
#    这是有意为之——后端在进程内跑了 APScheduler（课程提醒、自动备份）和
#    数据库连接池监控线程。一旦开多个 worker，每个进程都会各起一份调度器，
#    导致提醒重复推送、自动备份重复执行。
#    如确实需要多进程，请先把调度器拆成独立容器/进程，再加 --workers。
UVICORN_WORKERS=4
# 日志级别（debug/info/warning/error，默认 info）
LOG_LEVEL=info

# ======================== 构建镜像源 ========================
# pip 镜像源地址（国内推荐清华源，海外可改为 https://pypi.org/simple）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# pip 镜像源域名（与 PIP_INDEX_URL 对应，用于 --trusted-host）
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# ======================== 预构建镜像来源 ========================
# 仅 docker-compose.deploy.yml 使用。GitHub Actions 会把镜像推送到
#   ghcr.io/<你的GitHub用户名小写>/coursemanage-{backend,frontend,mcp}
# 镜像仓库地址（如需换成国内加速仓库可修改）
IMAGE_REGISTRY=ghcr.io
# 镜像归属（改成你自己 fork 后的 GitHub 用户名，必须全小写）
IMAGE_OWNER=daiyu116
# 镜像版本：latest 跟随 main 分支；也可填 1.2.3 这样的发布版本号锁定
IMAGE_TAG=latest

# ======================== MCP 服务器（可选） ========================
# 用途：把课程管理能力以 Model Context Protocol 暴露给 AstrBot /
#       Claude Desktop / Cherry Studio / Dify 等第三方框架
# 启用：docker compose -f docker-compose.deploy.yml --profile mcp up -d
# 详细接入说明见 docs/MCP.md
#
# MCP 调用后端时使用的系统账号（建议单独创建专用账号，按最小权限授予角色）
MCP_API_USERNAME=admin
MCP_API_PASSWORD=Admin.123
# 传输方式：http = Streamable HTTP（推荐，远程接入）；sse = 兼容旧客户端；stdio 仅本地进程
MCP_TRANSPORT=http
# Streamable HTTP 端点路径
MCP_PATH=/mcp
# 对外映射端口
MCP_PORT=8765
# 监听地址：默认只允许本机访问；需被其它主机/容器访问时改为 0.0.0.0
MCP_BIND_HOST=127.0.0.1
# ★ 客户端访问令牌（强烈建议设置！客户端需带 Authorization: Bearer <令牌>）
# 生成方式：openssl rand -hex 24
MCP_AUTH_TOKEN=
# 只读模式：true 时完全不注册任何写操作工具（首次接入机器人建议先开启）
MCP_READONLY=true
# 是否允许 MCP 触发企业微信/邮件通知（默认禁止，避免机器人误发群消息）
MCP_ALLOW_NOTIFICATIONS=false
# 单次列表查询最多返回多少条（控制大模型上下文消耗）
MCP_MAX_ITEMS=50
